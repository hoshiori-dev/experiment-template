# Command rules for Codex CLI (execpolicy). High-automation governance: the agent pushes its
# own branches, opens and merges experiment pull requests, writes experiment issues and
# comments, and applies the approval label; it never force-pushes, pushes to main, edits or
# closes issues (Epics are commented on, never edited), defines labels, or changes repository
# settings. Rules match an argv prefix; the most restrictive matching rule wins. These lists
# catch slips; the platform's branch protection and the agent's token are the boundary.
# .claude/settings.json and opencode.json carry the same intent in their own pattern syntax.

prefix_rule(pattern = ["git", "push"], decision = "allow")
prefix_rule(
    pattern = ["git", "push", ["--force", "-f", "--force-with-lease"]],
    decision = "forbidden",
    justification = "History with run references is append-only; nothing is force-pushed.",
)
prefix_rule(
    pattern = ["git", "push", ["origin", "upstream"], ["main", "HEAD:main", "main:main"]],
    decision = "forbidden",
    justification = "main changes only through pull requests.",
)
prefix_rule(
    pattern = ["docker", "push"],
    decision = "forbidden",
    justification = "Images stay local; publishing is a human decision.",
)
prefix_rule(
    pattern = ["gh", "issue", ["edit", "close", "reopen", "delete"]],
    decision = "forbidden",
    justification = "Issues are commented on, never edited, closed or reopened by the agent.",
)
prefix_rule(
    pattern = ["gh", "pr", ["close", "ready", "review"]],
    decision = "forbidden",
    justification = "Pull request state beyond open, label, comment and merge is a human action.",
)
prefix_rule(
    pattern = ["gh", "label"],
    decision = "forbidden",
    justification = "Label definitions are platform configuration owned by humans.",
)
prefix_rule(
    pattern = ["gh", "repo", ["edit", "delete"]],
    decision = "forbidden",
    justification = "Repository settings are changed by a human.",
)
prefix_rule(
    pattern = ["gh", ["secret", "ruleset"]],
    decision = "forbidden",
    justification = "Secrets and rulesets are platform configuration owned by humans.",
)
prefix_rule(
    pattern = ["gh", "api"],
    decision = "prompt",
    justification = "gh api can write anything; a human confirms each call.",
)
prefix_rule(pattern = ["gh", "issue", ["view", "list", "create", "comment"]], decision = "allow")
prefix_rule(pattern = ["gh", "pr", ["view", "list", "create", "comment", "edit", "merge"]], decision = "allow")
prefix_rule(pattern = ["just"], decision = "allow")
prefix_rule(pattern = ["uv"], decision = "allow")
prefix_rule(pattern = ["docker", "build"], decision = "allow")
prefix_rule(pattern = ["docker", "run"], decision = "allow")
prefix_rule(pattern = ["pytest"], decision = "allow")
