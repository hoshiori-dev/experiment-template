{
  "fmt": {
    "useTabs": false,
    "indentWidth": 2,
    "lineWidth": 120,
    "newLineKind": "lf",
    "semiColons": true,
    "singleQuote": false,
    "proseWrap": "always",
    "exclude": [
      "LICENSE"
    ]
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  }
}
