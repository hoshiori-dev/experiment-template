# Build and launch recipes of this experiment. They are examples: how to build and run is
# the experiment's own choice, so edit or replace them. A recipe not found here falls back
# to the root justfile (check, budget, preflight, freeze, ...); do not reuse those names.

set fallback
set positional-arguments

exp := file_name(justfile_directory())
root := justfile_directory() / "../.."

# GPUs for informal runs, as docker's --gpus value ("all" or a count); empty means none:
# just gpus=all try <command>... A Formal Run takes its accelerator from the run record.

gpus := ""

# Build the image from the working tree, for informal runs: just build
build:
    docker build -t "{{ exp }}:dev" "{{ justfile_directory() }}"

# Informal run: launch a command in the working-tree image, offline; nothing is kept: just try <command>...
try +command: build
    #!/usr/bin/env bash
    set -euo pipefail
    data="$(cd "{{ root }}" && pwd)/.local/data"
    mkdir -p "$data"
    gpu=()
    if [ -n "{{ gpus }}" ]; then gpu=(--gpus "{{ gpus }}"); fi
    docker run --rm --init --network none --user "$(id -u):$(id -g)" --tmpfs /tmp --tmpfs /out -e HOME=/tmp \
        "${gpu[@]}" -v "$data:/data:ro" "{{ exp }}:dev" "$@"

# Formal Run: launch a command in the image of the run's source commit, offline, with data
# read-only and outputs under .local/runs/<exp-id>/<R###>/. Accelerator and time limit come
# from the run record: a requested GPU is passed or the launch fails, and the container is
# stopped at max_duration (one launch; a resumed run has to subtract the time already used):
# just run <R###> <command>...
run id +command:
    #!/usr/bin/env bash
    set -euo pipefail
    root="$(cd "{{ root }}" && pwd)"
    commit=$(cd "$root" && uv run python scripts/source_commit.py "{{ exp }}" "$1") || { echo "$commit" >&2; exit 1; }
    record=$(git -C "$root" show "$commit:experiments/{{ exp }}/runs/$1.yaml" | (cd "$root" && uv run python -c '
    import re, sys, yaml
    record = yaml.safe_load(sys.stdin)
    parts = re.fullmatch(r"P(?:(\d+)W)?(?:(\d+)D)?(?:T(?:(\d+)H)?(?:(\d+)M)?(?:(\d+(?:\.\d+)?)S)?)?", record["max_duration"])
    if not parts:
        sys.exit("max_duration: write it in weeks, days, hours, minutes and seconds")
    weeks, days, hours, minutes, seconds = (float(part or 0) for part in parts.groups())
    limit = int(weeks * 604800 + days * 86400 + hours * 3600 + minutes * 60 + seconds)
    print(limit, record["resources"]["accelerator"], record["resources"]["count"])
    '))
    read -r limit accelerator count <<<"$record"
    context=$(mktemp -d)
    name="{{ exp }}-$1-$$"
    trap 'rm -rf "$context"; docker rm -f "$name" >/dev/null 2>&1 || true' EXIT
    git -C "$root" archive "$commit:experiments/{{ exp }}" | tar -x -C "$context"
    docker build -t "{{ exp }}:${commit:0:12}" "$context"
    out="$root/.local/runs/{{ exp }}/$1"
    mkdir -p "$out" "$root/.local/trackio" "$root/.local/data"
    gpu=()
    if [ "$accelerator" = gpu ]; then gpu=(--gpus "$count"); fi
    status=0
    timeout --signal=TERM --kill-after=30 "$limit" \
        docker run --rm --init --name "$name" --network none --user "$(id -u):$(id -g)" --tmpfs /tmp -e HOME=/tmp \
        "${gpu[@]}" -e SOURCE_COMMIT="$commit" -e FORMAL_RUN="{{ exp }}/$1" \
        -v "$root/.local/data:/data:ro" -v "$out:/out" -v "$root/.local/trackio:/trackio" -e TRACKIO_DIR=/trackio \
        "{{ exp }}:${commit:0:12}" "${@:2}" || status=$?
    if [ "$status" -eq 124 ] || [ "$status" -eq 137 ]; then
        echo "$1: stopped at max_duration (${limit}s); record the outcome as aborted" >&2
    fi
    exit "$status"
