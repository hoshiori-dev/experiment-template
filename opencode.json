{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "allow",
      "git push --force*": "deny",
      "git push -f *": "deny",
      "git push * main": "deny",
      "git push origin main*": "deny",
      "git push -f": "deny",
      "git push --force": "deny",
      "git push * main:*": "deny",
      "git push * HEAD:main*": "deny",
      "docker push *": "deny",
      "gh issue edit *": "ask",
      "gh issue close *": "ask",
      "gh issue reopen *": "ask",
      "gh issue delete *": "ask",
      "gh pr close *": "ask",
      "gh pr ready *": "ask",
      "gh pr review *": "ask",
      "gh label create *": "ask",
      "gh label edit *": "ask",
      "gh label delete *": "ask",
      "gh label clone *": "ask",
      "gh repo edit *": "deny",
      "gh repo delete *": "deny",
      "gh secret *": "deny",
      "gh ruleset *": "deny",
      "gh api *": "ask"
    }
  }
}
